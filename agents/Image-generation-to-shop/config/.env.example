# Image-generation-to-shop Agent Configuration

# REQUIRED: Replicate API Token
# Get from https://replicate.com/api
REPLICATE_API_TOKEN=your_replicate_api_token_here

# REQUIRED: SerpApi API Key
# Get from https://serpapi.com
SERPAPI_API_KEY=your_serpapi_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8001
DEBUG=False

# Application
APP_NAME=Image-generation-to-shop Agent
APP_VERSION=1.0.0

# Image Generation Settings
IMAGE_MODEL=black-forest-labs/flux-schnell
GUIDANCE_SCALE=3.5
INFERENCE_STEPS=4

# Shopping Search Settings
SEARCH_ENGINE=google_lens
SEARCH_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
